---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contáctanos - Chotalac">
    <section class="py-12 md:py-16 lg:py-20">
        <div class="container mx-auto px-4">
            <h1
                class="contact-title text-3xl md:text-4xl lg:text-6xl font-titles-2 text-shadow-lg font-bold text-center mb-12 md:mb-16 text-gray-800"
            >
                Contáctanos
            </h1>
            
            <div class="locations-section mb-12 md:mb-16">
                <h2
                    class="locations-subtitle text-2xl md:text-3xl lg:text-4xl font-bold text-center text-primary mb-8 md:mb-12"
                >
                    Ubícanos en:
                </h2>

                <div class="locations-grid grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="location-card bg-primary-light rounded-lg p-6 space-y-4" data-index="0">
                        <h3
                            class="text-xl md:text-2xl font-bold text-primary mb-4"
                        >
                            Chiclayo
                        </h3>

                        <div class="space-y-3">
                            <div class="flex items-start gap-3">
                                <Icon
                                    name="map-pin-duotone"
                                    class="w-6 h-6 text-primary shrink-0 mt-1"
                                />
                                <div class="text-gray-700">
                                    <p>Av. Paúl Harris 1710 - La Victoria</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <Icon
                                    name="map-pin-duotone"
                                    class="w-6 h-6 text-primary shrink-0 mt-1"
                                />
                                <div class="text-gray-700">
                                    <p>Av. Juan Cuglievan 1322</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 pt-2">
                                <Icon
                                    name="phone-duotone"
                                    class="w-5 h-5 text-primary"
                                />
                                <a
                                    href="tel:+519460349772"
                                    class="text-gray-700 hover:text-primary transition-colors"
                                >
                                    +51 946 349 772
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <div class="location-card bg-secondary-light rounded-lg p-6 space-y-4" data-index="1">
                        <h3
                            class="text-xl md:text-2xl font-bold text-primary mb-4"
                        >
                            Trujillo
                        </h3>

                        <div class="space-y-3">
                            <div class="flex items-start gap-3">
                                <Icon
                                    name="map-pin-duotone"
                                    class="w-6 h-6 text-primary shrink-0 mt-1"
                                />
                                <div class="text-gray-700">
                                    <p>Mz. F, Lote 14 - Urb. Las Casuarias</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 pt-2">
                                <Icon
                                    name="phone-duotone"
                                    class="w-5 h-5 text-primary"
                                />
                                <a
                                    href="tel:+51977818729"
                                    class="text-gray-700 hover:text-primary transition-colors"
                                >
                                    +51 977 818 729
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <div class="location-card bg-tertiary-light rounded-lg p-6 space-y-4" data-index="2">
                        <h3
                            class="text-xl md:text-2xl font-bold text-primary mb-4"
                        >
                            Lima
                        </h3>

                        <div class="space-y-3">
                            <div class="flex items-start gap-3">
                                <Icon
                                    name="map-pin-duotone"
                                    class="w-6 h-6 text-primary shrink-0 mt-1"
                                />
                                <div class="text-gray-700">
                                    <p>
                                        Mz. M, Lote 8 Cooperativa Vivienda El
                                        Olivar 39 - Los Olivos
                                    </p>
                                    <p class="text-gray-500 text-sm mt-1">
                                        Referencia: Cuadra 32 de la Av.
                                        Universitaria, al costado del parque El
                                        Olivar.
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 pt-2">
                                <Icon
                                    name="phone-duotone"
                                    class="w-5 h-5 text-primary"
                                />
                                <a
                                    href="tel:+51977818729"
                                    class="text-gray-700 hover:text-primary transition-colors"
                                >
                                    +51 977 818 729
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="other-contacts-section">
                <h2
                    class="other-contacts-title text-2xl md:text-3xl lg:text-4xl font-bold text-center text-primary mb-8"
                >
                    Otros Contactos
                </h2>
                <div class="max-w-2xl mx-auto space-y-6">
                    <div
                        class="contact-item flex items-center justify-center gap-4 bg-quaternary-light rounded-lg p-6"
                        data-index="0"
                    >
                        <Icon
                            name="phone-duotone"
                            class="w-8 h-8 text-primary"
                        />
                        <a
                            href="tel:+51910017026"
                            class="text-xl md:text-2xl text-gray-700 hover:text-primary transition-colors font-semibold"
                        >
                            +51 910 017 026
                        </a>
                    </div>
                    <div
                        class="contact-item flex items-center justify-center gap-4 bg-quaternary-light rounded-lg p-6"
                        data-index="1"
                    >
                        <Icon
                            name="email-duotone"
                            class="w-8 h-8 text-primary"
                        />
                        <a
                            href="mailto:ventas@chotalac.com"
                            class="text-xl md:text-2xl text-gray-700 hover:text-primary transition-colors font-semibold"
                        >
                            ventas@chotalac.com
                        </a>
                    </div>
                    <div class="flex justify-center pt-4">
                        <a
                            href="https://wa.me/51910017026"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="whatsapp-button inline-flex items-center gap-3 bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-4 rounded-lg transition-colors text-lg md:text-xl shadow-lg hover:shadow-xl"
                        >
                            <Icon name="whatsapp-filled" class="w-8 h-8" />
                            <span>Escríbenos por WhatsApp</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<script>
    import { animate, stagger, inView } from "motion";

    function initContactAnimations() {
        const title = document.querySelector('.contact-title');
        const locationsSubtitle = document.querySelector('.locations-subtitle');
        const locationCards = document.querySelectorAll('.location-card');
        
        const otherContactsTitle = document.querySelector('.other-contacts-title');
        const contactItems = document.querySelectorAll('.contact-item');
        const whatsappButton = document.querySelector('.whatsapp-button');
        if (title) {
            inView(
                title as Element,
                () => {
                    animate(
                        title as Element,
                        {
                            opacity: [0, 1],
                            y: [50, 0]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (locationsSubtitle) {
            inView(
                locationsSubtitle as Element,
                () => {
                    animate(
                        locationsSubtitle as Element,
                        {
                            opacity: [0, 1],
                            y: [30, 0]
                        },
                        {
                            duration: 0.6,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (locationCards.length > 0) {
            inView(
                locationCards[0],
                () => {
                    animate(
                        locationCards,
                        {
                            opacity: [0, 1],
                            y: [50, 0],
                            scale: [0.9, 1]
                        },
                        {
                            duration: 0.5,
                            delay: stagger(0.15),
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.2 }
            );
        }
        if (otherContactsTitle) {
            inView(
                otherContactsTitle as Element,
                () => {
                    animate(
                        otherContactsTitle as Element,
                        {
                            opacity: [0, 1],
                            y: [30, 0]
                        },
                        {
                            duration: 0.6,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (contactItems.length > 0) {
            inView(
                contactItems[0],
                () => {
                    animate(
                        contactItems,
                        {
                            opacity: [0, 1],
                            y: [30, 0],
                            scale: [0.95, 1]
                        },
                        {
                            duration: 0.5,
                            delay: stagger(0.1),
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.2 }
            );
        }
        if (whatsappButton) {
            inView(
                whatsappButton as Element,
                () => {
                    animate(
                        whatsappButton as Element,
                        {
                            opacity: [0, 1],
                            y: [30, 0],
                            scale: [0.9, 1]
                        },
                        {
                            duration: 0.6,
                            delay: 0.2,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.2 }
            );
        }
    }

    document.addEventListener('DOMContentLoaded', initContactAnimations);
    document.addEventListener('astro:page-load', initContactAnimations);
</script>
