---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Iniciar Sesión - Chotalac">
    <section class="min-h-screen flex items-center justify-center py-12 md:py-16 lg:py-20">
        <div class="container mx-auto px-4">
            <div class="max-w-2xl mx-auto">
                <div class="login-header text-center mb-8">
                    <h1 class="login-title text-3xl md:text-4xl lg:text-5xl font-titles-2 font-bold text-gray-800 mb-2">
                        Iniciar Sesión
                    </h1>
                    <p class="login-subtitle text-gray-600">
                        Bienvenido de vuelta
                    </p>
                </div>
                <div class="login-form-container bg-white rounded-2xl shadow-xl p-8">
                    <form class="space-y-6">
                        <div class="form-field" data-index="0">
                            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
                                Correo Electrónico
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <Icon name="email-duotone" class="w-5 h-5 text-gray-400" />
                                </div>
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    required
                                    class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none transition-all duration-300 ease-in-out"
                                    placeholder="tu@email.com"
                                />
                            </div>
                        </div>
                        <div class="form-field" data-index="1">
                            <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">
                                Contraseña
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <Icon name="lock" class="w-5 h-5 text-gray-400" />
                                </div>
                                <input
                                    type="password"
                                    id="password"
                                    name="password"
                                    required
                                    class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none transition-all duration-300 ease-in-out"
                                    placeholder="Tu contraseña"
                                />
                            </div>
                        </div>
                        <div class="form-options flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <input
                                    id="remember-me"
                                    name="remember-me"
                                    type="checkbox"
                                    class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded cursor-pointer"
                                />
                                <label for="remember-me" class="ml-2 block text-sm text-gray-700 cursor-pointer">
                                    Recordarme
                                </label>
                            </div>
                            <a href="/recuperar-contrasena" class="text-sm text-primary hover:text-primary/80 font-semibold transition-colors">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>
                        <button
                            type="submit"
                            class="submit-button w-full bg-primary hover:bg-primary/90 cursor-pointer text-white font-bold py-3 px-4 rounded-lg transition-colors shadow-lg hover:shadow-xl"
                        >
                            Iniciar Sesión
                        </button>
                        <div class="form-footer text-center pt-4">
                            <p class="text-gray-600">
                                ¿No tienes una cuenta?{" "}
                                <a
                                    href="/registrate"
                                    class="text-primary hover:text-primary/80 font-semibold transition-colors"
                                >
                                    Regístrate
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</Layout>

<script>
    import { animate, inView, stagger } from "motion";

    function initLoginAnimation() {
        const title = document.querySelector('.login-title');
        const subtitle = document.querySelector('.login-subtitle');
        const formContainer = document.querySelector('.login-form-container');
        const formFields = document.querySelectorAll('.form-field');
        const formOptions = document.querySelector('.form-options');
        const submitButton = document.querySelector('.submit-button');
        const footer = document.querySelector('.form-footer');

        if (title) {
            inView(
                title as Element,
                () => {
                    animate(
                        title as Element,
                        {
                            opacity: [0, 1],
                            y: [-30, 0],
                            scale: [0.9, 1]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (subtitle) {
            inView(
                subtitle as Element,
                () => {
                    animate(
                        subtitle as Element,
                        {
                            opacity: [0, 1],
                            y: [-20, 0]
                        },
                        {
                            duration: 0.6,
                            delay: 0.2,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (formContainer) {
            inView(
                formContainer as Element,
                () => {
                    animate(
                        formContainer as Element,
                        {
                            opacity: [0, 1],
                            scale: [0.95, 1],
                            y: [30, 0]
                        },
                        {
                            duration: 0.7,
                            delay: 0.3,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.2 }
            );
        }
        if (formFields.length > 0) {
            inView(
                formFields[0],
                () => {
                    animate(
                        formFields,
                        {
                            opacity: [0, 1],
                            x: [-30, 0]
                        },
                        {
                            duration: 0.5,
                            delay: stagger(0.15, { start: 0.5 }),
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.2 }
            );
        }
        if (formOptions) {
            inView(
                formOptions as Element,
                () => {
                    animate(
                        formOptions as Element,
                        {
                            opacity: [0, 1],
                            y: [15, 0]
                        },
                        {
                            duration: 0.5,
                            delay: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.2 }
            );
        }
        if (submitButton) {
            inView(
                submitButton as Element,
                () => {
                    animate(
                        submitButton as Element,
                        {
                            opacity: [0, 1],
                            y: [20, 0],
                            scale: [0.9, 1]
                        },
                        {
                            duration: 0.6,
                            delay: 1,
                            easing: [0.22, 1, 0.36, 1]
                        }
                    );
                },
                { amount: 0.2 }
            );
        }
        if (footer) {
            inView(
                footer as Element,
                () => {
                    animate(
                        footer as Element,
                        {
                            opacity: [0, 1],
                            y: [15, 0]
                        },
                        {
                            duration: 0.5,
                            delay: 1.2,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.2 }
            );
        }
    }

    document.addEventListener('DOMContentLoaded', initLoginAnimation);
    document.addEventListener('astro:page-load', initLoginAnimation);
</script>