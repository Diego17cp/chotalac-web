---
interface Props {
    specifications: { name: string; value: string }[];
    description: string;
    featuresDetails: string;
    uses: { title: string; content: string }[];
}

const { specifications, description, featuresDetails, uses } = Astro.props;
---

<div class="product-details-grid grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 mb-16 md:mb-20">
    <div class="specifications-section space-y-6">
        <h2 class="specifications-title text-2xl md:text-3xl font-titles-2 font-bold text-gray-800">
            Especificaciones
        </h2>
        {specifications.length > 0 ? (
            <div class="specifications-table bg-white rounded-lg shadow-lg overflow-hidden">
                <table class="w-full">
                    <tbody>
                        {specifications.map((spec, index) => (
                            <tr class={`specification-row ${index % 2 === 0 ? 'bg-gray-50' : 'bg-white'}`} data-index={index}>
                                <td class="px-6 py-4 font-semibold text-gray-700 border-r border-gray-200">
                                    {spec.name}
                                </td>
                                <td class="px-6 py-4 text-gray-600">
                                    {spec.value}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        ) : (
            <p class="text-gray-600">No hay especificaciones disponibles.</p>
        )}
    </div>
    <div class="details-section space-y-8">
        <div class="description-block space-y-4">
            <h3 class="description-title text-xl md:text-2xl font-titles-2 font-bold text-gray-800">
                Descripción
            </h3>
            <p class="description-text text-gray-700 leading-relaxed">
                {description}
            </p>
        </div>
        {featuresDetails && (
            <div class="features-block space-y-4">
                <h3 class="features-title text-xl md:text-2xl font-titles-2 font-bold text-gray-800">
                    Características
                </h3>
                <p class="features-text text-gray-700 leading-relaxed">
                    {featuresDetails}
                </p>
            </div>
        )}
        {uses.length > 0 && (
            <div class="uses-block space-y-4">
                <h3 class="uses-title text-xl md:text-2xl font-titles-2 font-bold text-gray-800">
                    Usos
                </h3>
                <div class="uses-list space-y-3">
                    {uses.map((use, index) => (
                        <p class="use-item text-gray-700 leading-relaxed" data-index={index}>
                            <span class="font-bold">{use.title}:</span> {use.content}
                        </p>
                    ))}
                </div>
            </div>
        )}
    </div>
</div>

<script>
    import { animate, inView, stagger } from "motion";

    function initProductDetailsAnimation() {
        const specificationsTitle = document.querySelector('.specifications-title');
        const specificationsTable = document.querySelector('.specifications-table');
        const specificationRows = document.querySelectorAll('.specification-row');
        
        const descriptionTitle = document.querySelector('.description-title');
        const descriptionText = document.querySelector('.description-text');
        const featuresTitle = document.querySelector('.features-title');
        const featuresText = document.querySelector('.features-text');
        const usesTitle = document.querySelector('.uses-title');
        const useItems = document.querySelectorAll('.use-item');
        if (specificationsTitle) {
            inView(
                specificationsTitle as Element,
                () => {
                    animate(
                        specificationsTitle as Element,
                        {
                            opacity: [0, 1],
                            x: [-80, 0],
                            scale: [0.9, 1]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (specificationsTable) {
            inView(
                specificationsTable as Element,
                () => {
                    animate(
                        specificationsTable as Element,
                        {
                            opacity: [0, 1],
                            y: [50, 0],
                            scale: [0.95, 1]
                        },
                        {
                            duration: 0.8,
                            delay: 0.2,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (specificationRows.length > 0 && specificationsTable) {
            inView(
                specificationsTable as Element,
                () => {
                    animate(
                        specificationRows,
                        {
                            opacity: [0, 1],
                            x: [-30, 0]
                        },
                        {
                            duration: 0.5,
                            delay: stagger(0.05, { start: 0.4 }),
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (descriptionTitle) {
            inView(
                descriptionTitle as Element,
                () => {
                    animate(
                        descriptionTitle as Element,
                        {
                            opacity: [0, 1],
                            x: [80, 0],
                            scale: [0.9, 1]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (descriptionText) {
            inView(
                descriptionText as Element,
                () => {
                    animate(
                        descriptionText as Element,
                        {
                            opacity: [0, 1],
                            y: [30, 0]
                        },
                        {
                            duration: 0.6,
                            delay: 0.2,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (featuresTitle) {
            inView(
                featuresTitle as Element,
                () => {
                    animate(
                        featuresTitle as Element,
                        {
                            opacity: [0, 1],
                            x: [80, 0],
                            scale: [0.9, 1]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (featuresText) {
            inView(
                featuresText as Element,
                () => {
                    animate(
                        featuresText as Element,
                        {
                            opacity: [0, 1],
                            y: [30, 0]
                        },
                        {
                            duration: 0.6,
                            delay: 0.2,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (usesTitle) {
            inView(
                usesTitle as Element,
                () => {
                    animate(
                        usesTitle as Element,
                        {
                            opacity: [0, 1],
                            x: [80, 0],
                            scale: [0.9, 1]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (useItems.length > 0 && usesTitle) {
            inView(
                usesTitle as Element,
                () => {
                    animate(
                        useItems,
                        {
                            opacity: [0, 1],
                            x: [40, 0]
                        },
                        {
                            duration: 0.5,
                            delay: stagger(0.1, { start: 0.2 }),
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
    }

    if ('requestIdleCallback' in window) {
        requestIdleCallback(() => {
            initProductDetailsAnimation();
        });
    } else {
        setTimeout(() => {
            initProductDetailsAnimation();
        }, 100);
    }

    document.addEventListener('astro:page-load', () => {
        if ('requestIdleCallback' in window) {
            requestIdleCallback(() => {
                initProductDetailsAnimation();
            });
        } else {
            setTimeout(() => {
                initProductDetailsAnimation();
            }, 100);
        }
    });
</script>