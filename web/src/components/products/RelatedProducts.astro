---
import type { FeaturedProduct } from "@/types";

interface Props {
    products: FeaturedProduct[];
}

const { products } = Astro.props;

const lightColors = [
    "bg-primary-light",
    "bg-secondary-light",
    "bg-tertiary-light",
    "bg-quaternary-light",
];
---

<section class="related-products-section py-12">
    <h2 class="related-products-title text-2xl md:text-3xl lg:text-4xl font-titles-2 font-bold text-center mb-8 md:mb-12 text-gray-800">
        Productos Relacionados
    </h2>
    <div class="related-products-grid flex flex-wrap justify-center gap-6">
        {products.map((product, index) => {
            const bgColor = lightColors[index % lightColors.length];
            return (
                <a
                    href={`/productos/${product.id}`}
                    class={`related-product-card ${bgColor} rounded-lg p-6 hover:shadow-lg transition-all duration-300 hover:scale-105 flex flex-col w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]`}
                    data-index={index}
                >
                    <div class="mb-4">
                        <h3 class="text-xl font-bold text-gray-800 mb-2">
                            {product.name}
                        </h3>
                        {product.presentationName && (
                            <p class="text-sm text-gray-600">
                                {product.presentationName}
                            </p>
                        )}
                    </div>
                    <div class="mt-auto flex items-center justify-center">
                        <img
                            src={product.imageUrl}
                            alt={`${product.name}${product.presentationName ? ' - ' + product.presentationName : ''}`}
                            class="w-full h-48 object-contain"
                            loading="lazy"
                        />
                    </div>
                </a>
            );
        })}
    </div>
</section>

<script>
    import { animate, inView, stagger } from "motion";

    function initRelatedProductsAnimation() {
        const title = document.querySelector('.related-products-title');
        const productsGrid = document.querySelector('.related-products-grid');
        const productCards = document.querySelectorAll('.related-product-card');
        if (title) {
            inView(
                title as Element,
                () => {
                    animate(
                        title as Element,
                        {
                            opacity: [0, 1],
                            y: [80, 0],
                            scale: [0.9, 1]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (productsGrid && productCards.length > 0) {
            inView(
                productsGrid as Element,
                () => {
                    animate(
                        productCards,
                        {
                            opacity: [0, 1],
                            y: [60, 0],
                            scale: [0.85, 1]
                        },
                        {
                            duration: 0.5,
                            delay: stagger(0.1),
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.2 }
            );
        }
    }

    if ('requestIdleCallback' in window) {
        requestIdleCallback(() => {
            initRelatedProductsAnimation();
        });
    } else {
        setTimeout(() => {
            initRelatedProductsAnimation();
        }, 100);
    }

    document.addEventListener('astro:page-load', () => {
        if ('requestIdleCallback' in window) {
            requestIdleCallback(() => {
                initRelatedProductsAnimation();
            });
        } else {
            setTimeout(() => {
                initRelatedProductsAnimation();
            }, 100);
        }
    });
</script>