---
import { Icon } from "astro-icon/components";
---

<section class="py-12 md:py-16 lg:py-20">
    <div class="container mx-auto px-4">
        <h2
            class="mvv-title text-3xl md:text-4xl lg:text-5xl font-titles-2 text-shadow-lg font-bold text-center mb-12 md:mb-16 text-gray-800"
        >
            Nuestros Pilares
        </h2>
        <div class="mvv-cards-container grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
            <div
                class="mvv-card bg-primary-light rounded-lg p-8 text-center hover:shadow-xl transition-shadow duration-300"
                data-index="0"
            >
                <div class="flex justify-center mb-6">
                    <div class="bg-primary rounded-full p-4">
                        <Icon
                            name="target-filled"
                            class="w-12 h-12 text-white"
                        />
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-4">Misión</h3>
                <p class="text-gray-700 leading-relaxed">
                    Proporcionar productos lácteos de alta calidad y frescura
                    que nutran a las familias, promoviendo un estilo de vida
                    saludable y sostenible. Nos comprometemos a trabajar con
                    ganaderos locales, utilizando prácticas responsables que
                    respeten el bienestar animal y el medio ambiente.
                </p>
            </div>
            <div
                class="mvv-card bg-secondary-light rounded-lg p-8 text-center hover:shadow-xl transition-shadow duration-300"
                data-index="1"
            >
                <div class="flex justify-center mb-6">
                    <div class="bg-primary rounded-full p-4">
                        <Icon
                            name="light-bulb-filled"
                            class="w-12 h-12 text-white"
                        />
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-4">Visión</h3>
                <p class="text-gray-700 leading-relaxed">
                    Ser la empresa líder en la industria de lácteos en nuestra
                    región, reconocida por la excelencia de nuestros productos y
                    nuestro compromiso con la innovación, la sostenibilidad y el
                    bienestar de nuestras comunidades.
                </p>
            </div>
            <div
                class="mvv-card bg-tertiary-light rounded-lg p-8 text-center hover:shadow-xl transition-shadow duration-300"
                data-index="2"
            >
                <div class="flex justify-center mb-6">
                    <div class="bg-primary rounded-full p-4">
                        <Icon
                            name="diamond-filled"
                            class="w-12 h-12 text-white"
                        />
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-4">Valores</h3>
                <ul class="text-gray-700 leading-relaxed space-y-2 text-left">
                    <li class="flex items-start">
                        <span class="text-primary mr-2">•</span>
                        <span>Calidad</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-primary mr-2">•</span>
                        <span>Sostenibilidad</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-primary mr-2">•</span>
                        <span>Compromiso con la comunidad</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-primary mr-2">•</span>
                        <span>Responsabilidad social</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-primary mr-2">•</span>
                        <span>Bienestar animal</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-primary mr-2">•</span>
                        <span>Innovación</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<script>
    import { animate, inView, stagger } from "motion";

    function initMVVAnimation() {
        const title = document.querySelector('.mvv-title');
        const cards = document.querySelectorAll('.mvv-card');

        if (title) {
            inView(
                title as Element,
                () => {
                    animate(
                        title as Element,
                        {
                            opacity: [0, 1],
                            y: [100, 0]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
        if (cards.length > 0) {
            inView(
                cards[0],
                () => {
                    animate(
                        cards,
                        {
                            opacity: [0, 1],
                            y: [100, 0],
                            scale: [0.9, 1]
                        },
                        {
                            duration: 0.6,
                            delay: stagger(0.15),
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.2 }
            );
        }
    }

    document.addEventListener('DOMContentLoaded', initMVVAnimation);
    document.addEventListener('astro:page-load', initMVVAnimation);
</script>
