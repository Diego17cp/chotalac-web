<section class="py-12 md:py-16 lg:py-20">
    <div class="container mx-auto px-4">
        <h2
            class="history-title text-3xl md:text-4xl lg:text-6xl font-titles-2 text-shadow-lg font-bold text-center mb-12 md:mb-16 text-gray-800"
        >
            Nuestra Historia
        </h2>
        <div
            class="history-section-1 grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center mb-12 md:mb-16"
        >
            <div class="history-text-1 order-1">
                <h3 class="text-2xl md:text-3xl font-bold text-primary mb-4">
                    Los Inicios
                </h3>
                <p
                    class="text-gray-700 text-lg md:text-2xl leading-relaxed mb-4"
                >
                    Nuestra historia comenzó en 1995, con el propósito de
                    impulsar el desarrollo de las comunidades productoras de
                    leche en la sierra de Cajamarca. De ese sueño nació
                    Chotalac, una empresa que une tradición y calidad para
                    transformar la leche fresca en productos llenos de sabor y
                    nutrición.
                </p>
            </div>
            <div class="history-image-1 order-2">
                <img
                    src="/images/about-us/our-history-1.webp"
                    alt="Los inicios de Chotalac"
                    class="w-full h-64 md:h-80 lg:h-96 rounded-lg shadow-lg object-cover object-top"
                />
            </div>
        </div>
        <div
            class="history-section-2 grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center"
        >
            <div class="history-image-2 order-2 lg:order-1">
                <img
                    src="/images/about-us/our-history-2.webp"
                    alt="Crecimiento de Chotalac"
                    class="w-full h-auto rounded-lg shadow-lg object-cover"
                />
            </div>
            <div class="history-text-2 order-1 lg:order-2">
                <h3
                    class="text-2xl md:text-3xl text-left md:text-right font-bold text-primary mb-4"
                >
                    Crecimiento y Expansión
                </h3>
                <p
                    class="text-gray-700 text-lg md:text-2xl text-left md:text-right leading-relaxed mb-4"
                >
                    Con el tiempo, crecimos y llevamos nuestros productos
                    ciudades del país, manteniendo siempre el mismo compromiso:
                    ofrecer productos naturales, frescos y elaborados con
                    pasión, para acompañar y nutrir a las familias peruanas cada
                    día.
                </p>
            </div>
        </div>
    </div>
</section>

<script>
    import { animate, inView } from "motion";

    function initHistoryAnimation() {
        const title = document.querySelector('.history-title');
        
        const text1 = document.querySelector('.history-text-1');
        const image1 = document.querySelector('.history-image-1');
        
        const text2 = document.querySelector('.history-text-2');
        const image2 = document.querySelector('.history-image-2');

        if (title) {
            inView(
                title as Element,
                () => {
                    animate(
                        title as Element,
                        {
                            opacity: [0, 1],
                            y: [100, 0]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }

        if (text1) {
            inView(
                text1 as Element,
                () => {
                    animate(
                        text1 as Element,
                        {
                            opacity: [0, 1],
                            x: [-150, 0]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }

        if (image1) {
            inView(
                image1 as Element,
                () => {
                    animate(
                        image1 as Element,
                        {
                            opacity: [0, 1],
                            x: [150, 0],
                            scale: [0.8, 1]
                        },
                        {
                            duration: 0.8,
                            delay: 0.2,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }

        if (image2) {
            inView(
                image2 as Element,
                () => {
                    animate(
                        image2 as Element,
                        {
                            opacity: [0, 1],
                            x: [-150, 0],
                            scale: [0.8, 1]
                        },
                        {
                            duration: 0.8,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }

        if (text2) {
            inView(
                text2 as Element,
                () => {
                    animate(
                        text2 as Element,
                        {
                            opacity: [0, 1],
                            x: [150, 0]
                        },
                        {
                            duration: 0.8,
                            delay: 0.2,
                            easing: "ease-out"
                        }
                    );
                },
                { amount: 0.3 }
            );
        }
    }

    document.addEventListener('DOMContentLoaded', initHistoryAnimation);
    document.addEventListener('astro:page-load', initHistoryAnimation);
</script>
