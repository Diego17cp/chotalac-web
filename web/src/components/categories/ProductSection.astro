---
import PresentationCard from "./PresentationCard.astro";

interface Props {
    name: string;
    presentations: {
        id: string;
        name: string;
        imageUrl: string;
    }[];
    cardBg: string;
}

const { name, presentations, cardBg } = Astro.props;
---

<div class="product-section space-y-8">
    <h2 class="product-section-title text-2xl md:text-3xl lg:text-4xl font-titles-2 font-bold text-center text-gray-800">
        {name}
    </h2>
    
    <div class="product-cards-container flex flex-wrap justify-center gap-6">
        {presentations.map((presentation, index) => (
            <PresentationCard
                id={presentation.id}
                name={presentation.name}
                imageUrl={presentation.imageUrl}
                cardBg={cardBg}
                index={index}
            />
        ))}
    </div>
</div>

<script>
    import { animate, inView, stagger } from "motion";

    function initProductSectionAnimation() {
        const sections = document.querySelectorAll('.product-section');

        sections.forEach((section) => {
            const title = section.querySelector('.product-section-title');
            const cardsContainer = section.querySelector('.product-cards-container');
            const cards = section.querySelectorAll('.presentation-card');

            // Animación del título
            if (title) {
                inView(
                    title as Element,
                    () => {
                        animate(
                            title as Element,
                            {
                                opacity: [0, 1],
                                y: [80, 0],
                                scale: [0.9, 1]
                            },
                            {
                                duration: 0.8,
                                easing: "ease-out"
                            }
                        );
                    },
                    { amount: 0.3 }
                );
            }

            // Animación escalonada de las cards
            if (cardsContainer && cards.length > 0) {
                inView(
                    cardsContainer as Element,
                    () => {
                        animate(
                            cards,
                            {
                                opacity: [0, 1],
                                y: [60, 0],
                                scale: [0.8, 1]
                            },
                            {
                                duration: 0.5,
                                delay: stagger(0.05),
                                easing: "ease-out"
                            }
                        );
                    },
                    { amount: 0.2 }
                );
            }
        });
    }

    if ('requestIdleCallback' in window) {
        requestIdleCallback(() => {
            initProductSectionAnimation();
        });
    } else {
        setTimeout(() => {
            initProductSectionAnimation();
        }, 100);
    }

    document.addEventListener('astro:page-load', () => {
        if ('requestIdleCallback' in window) {
            requestIdleCallback(() => {
                initProductSectionAnimation();
            });
        } else {
            setTimeout(() => {
                initProductSectionAnimation();
            }, 100);
        }
    });
</script>