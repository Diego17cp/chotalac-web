---
interface Props {
    id: string;
    name: string;
    imageUrl: string;
    bgColor: string;
    isReversed?: boolean;
    bgTextColor: string;
}

const { id, name, imageUrl, bgColor, isReversed = false, bgTextColor } = Astro.props;
---

<a
    href={`/category/${id}`}
    class={`${bgColor} flex w-full min-h-[400px] md:min-h-[500px] lg:min-h-[600px] hover:opacity-90 transition-opacity duration-300 group ${isReversed ? 'flex-row-reverse' : ''}`}
>
    <div class={`flex items-center justify-center py-6 px-6 md:px-8 lg:px-12 ${bgTextColor} shrink-0`}>
        <h2
            class={`text-4xl md:text-5xl lg:text-6xl xl:text-9xl font-titles text-white font-bold group-hover:brightness-110 transition-all duration-300`}
            style={`writing-mode: vertical-rl; text-orientation: mixed; ${!isReversed ? 'transform: rotate(180deg);' : ''}`}
        >
            {name.toUpperCase()}
        </h2>
    </div>
    <div class="flex-1 relative overflow-hidden">
        <img
            src={imageUrl}
            alt={`Categoría ${name}`}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
    </div>
</a>