---
interface Props {
    id: string;
    name: string;
    imageUrl: string;
    bgColor: string;
    isReversed?: boolean;
    bgTextColor: string;
}

const { id, name, imageUrl, bgColor, isReversed = false, bgTextColor } = Astro.props;
---

<a
    href={`/category/${id}`}
    class={`category-item ${bgColor} flex w-full min-h-[400px] md:min-h-[500px] lg:min-h-[600px] hover:opacity-90 transition-opacity duration-300 group ${isReversed ? 'flex-row-reverse' : ''}`}
    data-reversed={isReversed}
>
    <div class={`category-text flex items-center justify-center py-6 px-6 md:px-8 lg:px-12 ${bgTextColor} shrink-0`}>
        <h2
            class={`text-4xl text-center md:text-5xl lg:text-6xl xl:text-9xl font-titles text-white font-bold group-hover:brightness-110 transition-all duration-300`}
            style={`writing-mode: vertical-rl; text-orientation: mixed; ${!isReversed ? 'transform: rotate(180deg);' : ''}`}
        >
            {name.toUpperCase()}
        </h2>
    </div>
    <div class="category-image-wrapper flex-1 relative overflow-hidden">
        <img
            src={imageUrl}
            alt={`Categoría ${name}`}
            class="category-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
    </div>
</a>

<script>
    import { scroll, animate } from "motion";

    function initCategoryItemAnimation() {
        const categoryItems = document.querySelectorAll('.category-item');

        categoryItems.forEach((item) => {
            const isReversed = (item as HTMLElement).dataset.reversed === 'true';
            const text = item.querySelector('.category-text');
            const image = item.querySelector('.category-image');
            if (text) {
                scroll(
                    animate(
                        text as Element,
                        {
                            opacity: [0, 1, 1, 0],
                            scale: [0.8, 1, 1, 0.8],
                            x: isReversed ? [100, 0, 0, -100] : [-100, 0, 0, 100]
                        }
                    ),
                    {
                        target: item as Element,
                        offset: ["start end", "start 0.6", "end 0.4", "end start"]
                    }
                );
            }
            if (image) {
                scroll(
                    animate(
                        image as Element,
                        {
                            opacity: [0, 1, 1, 0],
                            scale: [1.3, 1, 1, 1.3]
                        }
                    ),
                    {
                        target: item as Element,
                        offset: ["start end", "start 0.5", "end 0.5", "end start"]
                    }
                );
            }
        });
    }

    document.addEventListener('DOMContentLoaded', initCategoryItemAnimation);
    document.addEventListener('astro:page-load', initCategoryItemAnimation);
</script>