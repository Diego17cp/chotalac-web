---
import type { FeaturedProduct } from "@/types";

interface Props {
    products: FeaturedProduct[];
}

const { products } = Astro.props;

const lightColors = [
    "bg-primary-light",
    "bg-secondary-light",
    "bg-tertiary-light",
    "bg-quaternary-light",
];
---

<section class="py-12 md:py-16 lg:py-20" id="featured-products">
    <div class="container mx-auto px-4">
        <h2
            class="featured-title text-3xl md:text-4xl lg:text-5xl font-titles-2 text-shadow-lg font-bold text-center mb-8 md:mb-12 text-gray-800"
        >
            Productos Destacados
        </h2>

        <div
            class="featured-cards-container grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6"
        >
            {
                products.map((product, index) => {
                    const bgColor = lightColors[index % lightColors.length];
                    return (
                        <a
                            href={`/productos/${product.id}`}
                            class={`featured-card ${bgColor} rounded-lg p-6 hover:shadow-lg transition-all duration-300 hover:scale-105 flex flex-col`}
                            data-index={index}
                        >
                            <div class="mb-4">
                                <h3 class="text-xl font-bold text-gray-800 mb-2">
                                    {product.name}
                                </h3>
                                {product.presentationName && (
                                    <p class="text-sm text-gray-600">
                                        {product.presentationName}
                                    </p>
                                )}
                            </div>
                            <div class="mt-auto flex items-center justify-center">
                                <img
                                    src={product.imageUrl}
                                    alt={`${product.name}${product.presentationName ? ' - ' + product.presentationName : ''}`}
                                    class="w-full h-48 object-contain"
                                />
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </div>
</section>

<script>
    import { scroll, animate, stagger } from "motion";

    function initFeaturedProductsAnimation() {
        const title = document.querySelector('.featured-title');
        const cardsContainer = document.querySelector('.featured-cards-container');
        const cards = document.querySelectorAll('.featured-card');

        // Animación del título con scroll
        if (title) {
            scroll(
                animate(
                    title as Element,
                    {
                        opacity: [0, 1, 1, 0],
                        y: [100, 0, 0, -100]
                    }
                ),
                {
                    target: title as Element,
                    offset: ["start end", "start center", "end center", "end start"]
                }
            );
        }

        // Animación escalonada de las cards con scroll
        if (cardsContainer && cards.length > 0) {
            scroll(
                animate(
                    cards,
                    {
                        opacity: [0, 1, 1, 0],
                        x: [-150, 0, 0, 150]
                    },
                    {
                        delay: stagger(0.1)
                    }
                ),
                {
                    target: cardsContainer as Element,
                    offset: ["start end", "start center", "end center", "end start"]
                }
            );
        }
    }

    document.addEventListener('DOMContentLoaded', initFeaturedProductsAnimation);
    document.addEventListener('astro:page-load', initFeaturedProductsAnimation);
</script>